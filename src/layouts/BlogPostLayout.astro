---
import ArticleLayout from './ArticleLayout.astro';
import Button from '@/components/common/Button.astro';
import { formatDate } from '@/utils/formatDate';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  category: string;
  tags: string[];
}

const { title, description, publishedAt, updatedAt, author, category, tags } = Astro.props;
---

<ArticleLayout eyebrow="Blog" title={title} description={description}>
  <Fragment slot="header">
    <p class="mt-5 text-base leading-relaxed text-content-secondary md:text-lg">
      {description}
    </p>
    <div class="mt-7 flex flex-wrap items-center gap-x-3 gap-y-2 text-sm text-content-tertiary">
      <span class="rounded-full bg-surface-primary px-3 py-1 text-xs font-semibold text-content-brand">
        {category}
      </span>
      <span>{author}</span>
      <span aria-hidden="true">·</span>
      <span>{formatDate(publishedAt)}</span>
      {updatedAt && (
        <span>(수정 {formatDate(updatedAt)})</span>
      )}
    </div>
  </Fragment>

  <slot />

  <Fragment slot="body-end">
    {tags.length > 0 && (
      <div class="mt-12 border-t border-line-secondary pt-8">
        <div class="flex flex-wrap gap-2">
          {tags.map((tag) => (
            <span class="rounded-full bg-surface-card px-3 py-1 text-sm text-content-brand">#{tag}</span>
          ))}
        </div>
      </div>
    )}

    <div class="mt-12">
      <Button href={`${ SITE.base }/blog`} variant="outline" shape="pill">
        <span aria-hidden="true">←</span>
        블로그 목록으로
      </Button>
    </div>
  </Fragment>
</ArticleLayout>
