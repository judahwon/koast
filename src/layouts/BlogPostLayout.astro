---
import BaseLayout from './BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Button from '@/components/common/Button.astro';
import { formatDate } from '@/utils/formatDate';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  updatedAt?: Date;
  author: string;
  category: string;
  tags: string[];
}

const { title, description, publishedAt, updatedAt, author, category, tags } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <Header />
  <main class="min-h-screen">
    <article class="mx-auto max-w-3xl px-6 py-16">
      <!-- Header -->
      <header class="mb-10">
        <div class="mb-4 flex items-center gap-2">
          <span class="rounded-full bg-surface-info-subtle px-2 py-0.5 text-xs font-medium text-content-interactive-primary">
            {category}
          </span>
          <span class="text-xs text-content-disabled">
            {formatDate(publishedAt)}
          </span>
          {updatedAt && (
            <span class="text-xs text-content-disabled">
              (수정: {formatDate(updatedAt)})
            </span>
          )}
        </div>
        <h1 class="text-3xl leading-tight font-bold text-content-primary md:text-4xl">
          {title}
        </h1>
        <p class="mt-4 text-lg text-content-tertiary">
          {description}
        </p>
        <div class="mt-4 flex items-center gap-2 text-sm text-content-disabled">
          <span>{author}</span>
        </div>
      </header>

      <!-- Content -->
      <div class="prose prose-gray dark:prose-invert prose-headings:text-content-primary prose-a:text-content-interactive-primary prose-code:text-content-interactive-primary prose-code:bg-surface-tertiary prose-code:px-1.5 prose-code:py-0.5 prose-code:rounded prose-pre:bg-surface-tertiary max-w-none">
        <slot />
      </div>

      <!-- Tags -->
      {tags.length > 0 && (
        <div class="mt-10 border-t border-line-secondary pt-6">
          <div class="flex flex-wrap gap-2">
            {tags.map((tag) => (
              <span class="rounded-full bg-surface-tertiary px-3 py-1 text-sm text-content-tertiary">
                #{tag}
              </span>
            ))}
          </div>
        </div>
      )}

      <!-- Back -->
      <div class="mt-10">
        <Button href={`${ SITE.base }/blog`} variant="outline" size="sm">
          ← 블로그 목록으로
        </Button>
      </div>
    </article>
  </main>
  <Footer />
</BaseLayout>
