---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Card from '@/components/common/Card.astro';
import ContactForm from '@/components/contact/ContactForm.tsx';
import CompanyInfo from '@/components/contact/CompanyInfo.astro';

const CHECKLIST = [
  '구축하고자 하는 시스템의 목적',
  '보유 중인 데이터 종류',
  '연동이 필요한 장비 또는 외부 시스템',
  '원하는 표출 방식',
  '예상 일정 및 예산 범위',
  '유지보수 필요 여부',
];
---

<PageLayout title="문의" description="프로젝트 상담, 솔루션 도입, 기술 협력 문의를 환영합니다.">
  <section class="bg-surface-primary">
    <div class="page-container py-20 lg:py-24">
      <div class="reveal text-center">
        <p class="text-sm font-bold tracking-wide text-content-brand">Contact Us</p>
        <h1 class="mt-3 text-3xl leading-snug font-bold tracking-tight break-keep text-content-primary sm:text-4xl lg:text-[2.5rem]">
          해양·기상 데이터 시스템, 무엇이든 문의하세요
        </h1>
        <p class="mx-auto mt-5 max-w-2xl text-base break-keep text-content-secondary">
          관측부터 예측, 시각화, 시스템 통합까지 목적에 맞는 솔루션을 제안드립니다.
          아래 연락처로 바로 연락하시거나 문의 폼을 남겨주세요.
        </p>
      </div>
    </div>
  </section>

  <section class="bg-surface-subtle">
    <div class="page-container py-20 lg:py-24">
      <SectionHeading
        eyebrow="Company Info"
        title="연락처 및 오시는 길"
        subtitle="대표 전화와 이메일로 바로 연결됩니다. 방문 상담은 사전에 연락 주시면 일정을 맞춰드립니다."
        class="reveal"
      />
      <div class="reveal mt-14">
        <CompanyInfo />
      </div>
    </div>
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20 lg:py-24">
      <SectionHeading
        eyebrow="Send a Message"
        title="온라인 문의"
        subtitle="남겨주신 내용은 담당자가 확인 후 영업일 기준으로 순차 답변드립니다."
        class="reveal"
      />
      <div class="reveal mt-14 grid gap-10 lg:grid-cols-3 lg:gap-12">
        <div class="lg:col-span-2">
          <ContactForm client:visible />
        </div>
        <aside class="lg:sticky lg:top-24 lg:self-start">
          <Card variant="filled">
            <h2 class="text-lg font-bold text-content-primary">문의 전 안내</h2>
            <p class="mt-3 text-sm leading-relaxed text-content-secondary">
              보다 정확한 상담을 위해 아래 내용을 함께 남겨주시면 빠르게 검토할 수 있습니다.
            </p>
            <ul class="mt-6 space-y-3 text-sm text-content-secondary">
              {CHECKLIST.map((item) => (
                <li class="flex items-start gap-2.5">
                  <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-surface-brand" />
                  {item}
                </li>
              ))}
            </ul>
          </Card>
        </aside>
      </div>
    </div>
  </section>
</PageLayout>
