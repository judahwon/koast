---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Button from '@/components/common/Button.astro';
import VisionMission from '@/components/about/VisionMission.astro';
import Timeline from '@/components/about/Timeline.astro';
import Certifications from '@/components/about/Certifications.astro';
import { HIGHLIGHTS } from '@/data/company';
import { SITE } from '@/utils/constants';
import heroCareers from '@/assets/images/careers/hero-careers.png';
---

<PageLayout title="회사소개" description="한국해양기상기술의 비전, 미션, 연혁, 인증을 소개합니다.">
  <!-- 고정 헤더가 상단에서 투명하므로 배경 밴드를 헤더 아래까지 끌어올린다. -->
  <section class="relative isolate -mt-16 overflow-hidden bg-surface-primary pt-36 pb-24 text-center sm:pt-44 sm:pb-32 lg:pt-52 lg:pb-40">
    <div class="page-container reveal">
      <h1 class="text-3xl leading-snug font-bold tracking-tight text-content-primary sm:text-4xl lg:text-5xl lg:leading-tight">
        해양·기상 데이터를<br class="hidden sm:inline" /> 의사결정으로 연결합니다
      </h1>
    </div>

    <Image
      src={heroCareers}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 size-full object-cover object-bottom select-none"
    />
  </section>

  <section class="bg-surface-subtle py-20 lg:py-28">
    <div class="page-container">
      <div class="reveal grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {
          HIGHLIGHTS.map((item) => (
            <div class="rounded-2xl bg-surface-primary px-6 py-8 text-center">
              <p class="text-3xl font-bold text-content-interactive-primary lg:text-4xl">{item.value}</p>
              <p class="mt-2 text-sm text-content-secondary">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <VisionMission />
  <Timeline />
  <Certifications />

  <section class="bg-surface-primary">
    <div class="page-container py-20 lg:py-28">
      <div class="reveal rounded-3xl bg-linear-to-br from-surface-card to-surface-subtle px-6 py-14 lg:p-16">
        <SectionHeading eyebrow="Contact Us" title="도입부터 운영까지 KOAST가 함께합니다" subtitle="관측 장비부터 예측 시스템, 시각화 플랫폼까지 목적에 맞는 구성을 제안드립니다." />
        <div class="mt-9 text-center">
          <Button href={`${ SITE.base }/contact`} size="lg" shape="pill">전문가에게 문의하기</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
