---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/common/Header.astro';
import Footer from '@/components/common/Footer.astro';
import Button from '@/components/common/Button.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ApplicationForm from '@/components/careers/ApplicationForm.tsx';
import { getCollection, render } from 'astro:content';
import { SITE } from '@/utils/constants';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs');
  return jobs.map((job) => ({
    params: { slug: job.id },
    props: { job },
  }));
}

const { job } = Astro.props;
const { Content } = await render(job);
const meta = [job.data.location, job.data.type, job.data.experience];
---

<BaseLayout title={job.data.title} description={`${ job.data.title } - ${ job.data.department } | 한국해양기상기술 채용`}>
  <Header />
  <main class="min-h-screen">
    <article>
      <section class="bg-surface-subtle">
        <div class="page-container pt-36 pb-16">
          <header class="reveal mx-auto max-w-3xl">
            <p class="text-sm font-bold tracking-wide text-content-brand">Careers</p>
            <h1 class="mt-3 text-3xl leading-snug font-bold tracking-tight text-content-primary md:text-[2.5rem]">
              {job.data.title}
            </h1>
            <div class="mt-6 flex flex-wrap items-center gap-2">
              <span class="rounded-full bg-surface-primary px-3 py-1 text-xs font-semibold text-content-brand">
                {job.data.department}
              </span>
              {meta.map((item) => (
                <span class="rounded-full border border-line-secondary px-3 py-1 text-xs text-content-secondary">{item}</span>
              ))}
            </div>
          </header>
        </div>
      </section>

      <section class="bg-surface-primary">
        <div class="page-container py-16">
          <div class="mx-auto max-w-3xl">
            <div class="post-body">
              <Content />
            </div>
          </div>
        </div>
      </section>

      <section class="bg-surface-subtle">
        <div class="page-container py-20">
          <SectionHeading
            eyebrow="Apply"
            title="지원하기"
            subtitle="이력서를 첨부해 지원해 주시면 검토 후 개별적으로 안내드립니다."
            class="reveal"
          />
          <div class="reveal mx-auto mt-12 max-w-3xl rounded-2xl border border-line-secondary bg-surface-primary p-6 md:p-10">
            <ApplicationForm jobTitle={job.data.title} jobSlug={job.id} client:visible />
          </div>
          <div class="mt-10 flex justify-center">
            <Button href={`${ SITE.base }/careers`} variant="outline" shape="pill">
              <span aria-hidden="true">←</span>
              채용 목록으로
            </Button>
          </div>
        </div>
      </section>
    </article>
  </main>
  <Footer />
</BaseLayout>
