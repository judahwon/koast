---
import ArticleLayout from '@/layouts/ArticleLayout.astro';
import Button from '@/components/common/Button.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ApplicationForm from '@/components/careers/ApplicationForm.tsx';
import { getCollection, render } from 'astro:content';
import { SITE } from '@/utils/constants';

export async function getStaticPaths() {
  const jobs = await getCollection('jobs', (job) => job.data.isActive);
  return jobs.map((job) => ({
    params: { slug: job.id },
    props: { job },
  }));
}

const { job } = Astro.props;
const { Content } = await render(job);
const meta = [job.data.location, job.data.type, job.data.experience];
---

<ArticleLayout eyebrow="Careers" title={job.data.title} description={`${ job.data.title } - ${ job.data.department } | 한국해양기상기술 채용`}>
  <div slot="header" class="mt-6 flex flex-wrap items-center gap-2">
    <span class="rounded-full bg-surface-primary px-3 py-1 text-xs font-semibold text-content-brand">
      {job.data.department}
    </span>
    {meta.map((item) => (
      <span class="rounded-full border border-line-secondary px-3 py-1 text-xs text-content-secondary">{item}</span>
    ))}
  </div>

  <Content />

  <section slot="after" class="bg-surface-subtle">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Apply"
        title="지원하기"
        subtitle="이력서를 첨부해 지원해 주시면 검토 후 개별적으로 안내드립니다."
        class="reveal"
      />
      <div class="reveal mx-auto mt-12 max-w-3xl rounded-2xl border border-line-secondary bg-surface-primary p-6 md:p-10">
        <ApplicationForm jobTitle={job.data.title} jobSlug={job.id} client:visible />
      </div>
      <div class="mt-10 flex justify-center">
        <Button href={`${ SITE.base }/careers`} variant="outline" shape="pill">
          <span aria-hidden="true">←</span>
          채용 목록으로
        </Button>
      </div>
    </div>
  </section>
</ArticleLayout>
