---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Card from '@/components/common/Card.astro';
import Icon from '@/components/common/Icon.astro';
import JobCard from '@/components/careers/JobCard.astro';
import { getCollection } from 'astro:content';
import { IDEAL_CANDIDATE, WORK_CULTURE, BENEFITS, HIRING_PROCESS } from '@/data/careers';
import heroCareers from '@/assets/images/careers/hero-careers.png';

const jobs = (await getCollection('jobs'))
  .filter((job) => job.data.isActive)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const iconTileClass = 'grid size-12 shrink-0 place-items-center rounded-xl bg-surface-primary text-content-brand';
---

<PageLayout title="채용" description="한국해양기상기술과 함께할 인재를 찾습니다.">
  <!-- 고정 헤더가 상단에서 투명하므로 배경 밴드를 헤더 아래까지 끌어올린다. -->
  <section class="relative isolate -mt-16 overflow-hidden bg-surface-primary pt-36 pb-24 text-center sm:pt-44 sm:pb-32 lg:pt-52 lg:pb-40">
    <div class="page-container reveal">
      <h1 class="text-3xl leading-snug font-bold tracking-tight text-content-primary sm:text-4xl lg:text-5xl lg:leading-tight">
        해양·기상 데이터 기술의 미래를<br class="hidden sm:inline" /> 함께 만들 동료를 찾습니다.
      </h1>
    </div>

    <Image
      src={heroCareers}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 size-full object-cover object-bottom select-none"
    />
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Who We Look For"
        title="이런 분과 함께하고 싶습니다"
        subtitle="도메인과 기술 중 어느 한쪽만으로는 풀 수 없는 문제를 함께 다룰 동료를 찾습니다."
        align="left"
        class="reveal"
      />
      <!-- 5개 카드를 12칸 그리드에 4-4-4 / 6-6 으로 배치해 마지막 줄 빈칸을 없앤다. -->
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-12">
        {IDEAL_CANDIDATE.map((item, i) => (
          <Card variant="filled" class={`flex h-full flex-col gap-5 ${ i < 3 ? 'lg:col-span-4' : 'lg:col-span-6' }`}>
            <div class="flex items-center justify-between gap-3">
              <span class={iconTileClass}>
                <Icon name={item.icon} class="size-6" />
              </span>
              <span class="text-sm font-bold text-content-brand">{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div>
              <h3 class="text-lg leading-snug font-bold text-content-primary">{item.label}</h3>
              <p class="mt-2 leading-relaxed text-content-secondary">{item.text}</p>
            </div>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section id="positions" class="scroll-mt-16 bg-surface-subtle">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Open Positions"
        title="모집 중인 포지션"
        subtitle="현재 채용 중인 직무를 확인하세요."
        class="reveal"
      />
      {jobs.length > 0 ? (
        <div class="reveal mt-12 grid gap-6">
          {jobs.map((job) => (
            <JobCard
              title={job.data.title}
              department={job.data.department}
              location={job.data.location}
              type={job.data.type}
              experience={job.data.experience}
              slug={job.id}
            />
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-2xl border border-line-secondary bg-surface-primary py-20 text-center text-content-tertiary">
          <p>현재 모집 중인 포지션이 없습니다.</p>
        </div>
      )}
    </div>
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Life at KOAST"
        title="일하는 방식과 근무환경"
        subtitle="연구개발과 실무 프로젝트가 이어지는 구조 안에서, 현장 데이터와 운영 시스템을 직접 다룹니다."
        align="left"
        class="reveal"
      />
      <div class="reveal mt-12 grid gap-6 lg:grid-cols-2">
        <Card variant="filled" class="h-full">
          <div class="flex items-center gap-4">
            <span class={iconTileClass}>
              <Icon name="Workflow" class="size-6" />
            </span>
            <h3 class="text-xl font-bold text-content-primary">일하는 방식</h3>
          </div>
          <ul class="mt-6 space-y-3">
            {WORK_CULTURE.map((item) => (
              <li class="flex items-start gap-3">
                <span class="grid size-8 shrink-0 place-items-center rounded-lg bg-surface-primary text-content-brand">
                  <Icon name={item.icon} class="size-4" />
                </span>
                <span class="pt-1 leading-relaxed text-content-secondary">{item.text}</span>
              </li>
            ))}
          </ul>
        </Card>
        <Card variant="filled" class="h-full">
          <div class="flex items-center gap-4">
            <span class={iconTileClass}>
              <Icon name="Heart" class="size-6" />
            </span>
            <h3 class="text-xl font-bold text-content-primary">복지·근무환경</h3>
          </div>
          <ul class="mt-6 grid gap-3 sm:grid-cols-2">
            {BENEFITS.map((item) => (
              <li class="flex items-center gap-3 rounded-xl border border-line-info-subtle bg-surface-primary px-4 py-3">
                <Icon name={item.icon} class="size-5 shrink-0 text-content-brand" />
                <span class="text-sm font-medium text-content-primary">{item.label}</span>
              </li>
            ))}
          </ul>
        </Card>
      </div>
    </div>
  </section>

  <section class="bg-surface-subtle">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Hiring Process"
        title="채용 프로세스"
        subtitle="지원서 접수부터 합류까지 네 단계로 진행됩니다."
        class="reveal"
      />
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {HIRING_PROCESS.map((item, i) => (
          <div class="relative h-full rounded-2xl border border-line-secondary bg-surface-primary p-6">
            <div class="flex items-center justify-between gap-3">
              <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-surface-card text-content-brand">
                <Icon name={item.icon} class="size-6" />
              </span>
              <span class="text-2xl font-bold text-content-interactive-primary">{item.step}</span>
            </div>
            <h3 class="mt-5 text-lg font-bold text-content-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-content-secondary">{item.description}</p>
            {i < HIRING_PROCESS.length - 1 && (
              <span class="absolute top-12 -right-6 hidden w-6 place-items-center text-content-tertiary lg:grid" aria-hidden="true">
                <Icon name="ChevronRight" class="size-4" />
              </span>
            )}
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
