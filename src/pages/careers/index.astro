---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import Button from '@/components/common/Button.astro';
import Card from '@/components/common/Card.astro';
import JobCard from '@/components/careers/JobCard.astro';
import { getCollection } from 'astro:content';
import { CAREERS_INTRO, IDEAL_CANDIDATE, WORK_CULTURE, BENEFITS, HIRING_PROCESS } from '@/data/careers';

const jobs = (await getCollection('jobs'))
  .filter((job) => job.data.isActive)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());
---

<PageLayout title="채용" description="한국해양기상기술과 함께할 인재를 찾습니다.">
  <!-- 고정 헤더가 상단에서 투명하므로 배경 밴드를 헤더 아래까지 끌어올린다. -->
  <section class="-mt-16 bg-surface-subtle">
    <div class="page-container reveal pt-36 pb-20">
      <SectionHeading
        eyebrow="Careers"
        title={CAREERS_INTRO.title}
        subtitle={CAREERS_INTRO.description}
      />
      <div class="mt-10 flex justify-center">
        <Button href="#positions" shape="pill" size="lg">
          모집 중인 포지션 보기
          <span aria-hidden="true">→</span>
        </Button>
      </div>
    </div>
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Who We Look For"
        title="이런 분과 함께하고 싶습니다"
        subtitle="도메인과 기술 중 어느 한쪽만으로는 풀 수 없는 문제를 함께 다룰 동료를 찾습니다."
        align="left"
        class="reveal"
      />
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
        {IDEAL_CANDIDATE.map((item, i) => (
          <Card variant="filled" class="flex h-full flex-col gap-3">
            <span class="text-sm font-bold text-content-brand">{String(i + 1).padStart(2, '0')}</span>
            <p class="leading-relaxed font-medium text-content-primary">{item}</p>
          </Card>
        ))}
      </div>
    </div>
  </section>

  <section id="positions" class="scroll-mt-16 bg-surface-subtle">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Open Positions"
        title="모집 중인 포지션"
        subtitle="현재 채용 중인 직무를 확인하세요."
        class="reveal"
      />
      {jobs.length > 0 ? (
        <div class="reveal mt-12 grid gap-6">
          {jobs.map((job) => (
            <JobCard
              title={job.data.title}
              department={job.data.department}
              location={job.data.location}
              type={job.data.type}
              experience={job.data.experience}
              slug={job.id}
            />
          ))}
        </div>
      ) : (
        <div class="mt-12 rounded-2xl border border-line-secondary bg-surface-primary py-20 text-center text-content-tertiary">
          <p>현재 모집 중인 포지션이 없습니다.</p>
        </div>
      )}
    </div>
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Life at KOAST"
        title="일하는 방식과 근무환경"
        subtitle="연구개발과 실무 프로젝트가 이어지는 구조 안에서, 현장 데이터와 운영 시스템을 직접 다룹니다."
        align="left"
        class="reveal"
      />
      <div class="reveal mt-12 grid gap-6 lg:grid-cols-2">
        <Card variant="filled" class="h-full">
          <h3 class="text-xl font-bold text-content-primary">일하는 방식</h3>
          <ul class="mt-5 space-y-3">
            {WORK_CULTURE.map((item) => (
              <li class="flex items-start gap-3">
                <span aria-hidden="true" class="mt-2 size-1.5 shrink-0 rounded-full bg-surface-brand"></span>
                <span class="leading-relaxed text-content-secondary">{item}</span>
              </li>
            ))}
          </ul>
        </Card>
        <Card variant="filled" class="h-full">
          <h3 class="text-xl font-bold text-content-primary">복지·근무환경</h3>
          <div class="mt-5 flex flex-wrap gap-2">
            {BENEFITS.map((item) => (
              <span class="rounded-full border border-line-info-subtle bg-surface-primary px-4 py-1.5 text-sm font-medium text-content-brand">{item}</span>
            ))}
          </div>
        </Card>
      </div>
    </div>
  </section>

  <section class="bg-surface-subtle">
    <div class="page-container py-20">
      <SectionHeading
        eyebrow="Hiring Process"
        title="채용 프로세스"
        subtitle="지원서 접수부터 합류까지 네 단계로 진행됩니다."
        class="reveal"
      />
      <div class="reveal mt-12 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
        {HIRING_PROCESS.map((item) => (
          <div class="h-full rounded-2xl border border-line-secondary bg-surface-primary p-6">
            <span class="text-2xl font-bold text-content-interactive-primary">{item.step}</span>
            <h3 class="mt-3 text-lg font-bold text-content-primary">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-content-secondary">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</PageLayout>
