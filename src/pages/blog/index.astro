---
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import BlogCard from '@/components/blog/BlogCard.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog'))
  .filter((post) => !post.data.draft)
  .sort((a, b) => b.data.publishedAt.valueOf() - a.data.publishedAt.valueOf());

const categories = [...new Set(posts.map((p) => p.data.category))];
---

<PageLayout title="블로그" description="해양·기상 데이터 기술에 관한 인사이트와 소식을 공유합니다.">
  <section class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading
      title="블로그"
      subtitle="해양·기상 데이터 기술에 관한 인사이트와 소식을 공유합니다."
    />

    <!-- Category filter -->
    <div class="mb-10 flex flex-wrap justify-center gap-2">
      {categories.map((cat) => (
        <span class="rounded-full bg-surface-info-subtle px-3 py-1 text-sm text-content-interactive-primary">
          {cat}
        </span>
      ))}
    </div>

    <!-- Posts grid -->
    <div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <BlogCard
          title={post.data.title}
          description={post.data.description}
          publishedAt={post.data.publishedAt}
          category={post.data.category}
          tags={post.data.tags}
          slug={post.id}
        />
      ))}
    </div>

    {posts.length === 0 && (
      <div class="py-12 text-center text-content-disabled">
        <p>아직 작성된 블로그 포스트가 없습니다.</p>
      </div>
    )}
  </section>
</PageLayout>
