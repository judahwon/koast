---
import PageLayout from '@/layouts/PageLayout.astro';
import Button from '@/components/common/Button.astro';
import { SITE, NAV_LINKS } from '@/utils/constants';
---

<PageLayout title="페이지를 찾을 수 없습니다" description="요청하신 페이지가 존재하지 않거나 주소가 변경되었습니다.">
  <!-- main 의 pt-16 을 뺀 높이여야 배경이 첫 화면을 정확히 채운다. -->
  <section class="flex min-h-[calc(100vh-4rem)] items-center bg-surface-subtle">
    <div class="page-container py-20 text-center">
      <div class="reveal">
        <p class="text-sm font-bold tracking-wide text-content-brand">Error 404</p>
        <p class="mt-4 text-7xl leading-none font-bold tracking-tight text-content-interactive-primary sm:text-8xl">404</p>
        <h1 class="mt-8 text-2xl font-bold tracking-tight text-content-primary sm:text-3xl lg:text-[2.5rem]">
          페이지를 찾을 수 없습니다
        </h1>
        <p class="mx-auto mt-5 max-w-xl text-base break-keep text-content-secondary">
          요청하신 페이지가 존재하지 않거나 주소가 변경되었습니다. 아래에서 원하시는 곳으로 이동해 주세요.
        </p>

        <div class="mt-10 flex flex-wrap justify-center gap-3">
          <Button href={`${ SITE.base }/`} size="lg" shape="pill">홈으로 돌아가기</Button>
          <Button href={`${ SITE.base }/contact`} size="lg" shape="pill" variant="outline">문의하기</Button>
        </div>

        <nav class="mx-auto mt-14 flex max-w-xl flex-wrap justify-center gap-x-8 gap-y-3 border-t border-line-secondary pt-8">
          {NAV_LINKS.map((link) => (
            <a
              href={`${ SITE.base }${ link.href }`}
              class="text-sm font-medium text-content-secondary transition-colors hover:text-content-interactive-primary"
            >
              {link.label}
            </a>
          ))}
        </nav>
      </div>
    </div>
  </section>
</PageLayout>
