---
import { Image } from 'astro:assets';
import PageLayout from '@/layouts/PageLayout.astro';
import SectionHeading from '@/components/common/SectionHeading.astro';
import ServiceCard from '@/components/services/ServiceCard.astro';
import Button from '@/components/common/Button.astro';
import { SERVICES, SOLUTIONS } from '@/data/services';
import { SITE } from '@/utils/constants';
import heroServices from '@/assets/images/services/hero-services.png';
---

<PageLayout title="서비스" description="한국해양기상기술이 제공하는 해양·기상 데이터 통합 솔루션을 소개합니다.">
  <!-- 고정 헤더가 상단에서 투명하므로 배경 밴드를 헤더 아래까지 끌어올린다. -->
  <section class="relative isolate -mt-16 overflow-hidden bg-[#03091e] pt-36 pb-24 text-center sm:pt-44 sm:pb-32 lg:pt-52 lg:pb-40">
    <div class="page-container reveal">
      <h1 class="text-3xl leading-snug font-bold tracking-tight text-white sm:text-4xl lg:text-5xl lg:leading-tight">
        관측부터 시각화까지,<br class="hidden sm:inline" /> 목적에 맞는 최적의 솔루션을 제공합니다.
      </h1>
    </div>

    <Image
      src={heroServices}
      alt=""
      widths={[768, 1280, 1920]}
      sizes="100vw"
      loading="eager"
      aria-hidden="true"
      class="pointer-events-none absolute inset-0 -z-10 size-full object-cover object-center select-none"
    />
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20 lg:py-28">
      <SectionHeading class="reveal" align="left" eyebrow="Service Areas" title={`${ SERVICES.length }개 핵심 서비스 영역`} subtitle="관측·수집 하드웨어부터 수치모델 예측, GIS 시각화, 관제 시스템 구축까지 전 과정을 하나의 팀이 담당합니다." />

      <div class="mt-14 grid items-start gap-6 lg:mt-16 lg:grid-cols-2">
        {SERVICES.map((service, i) => <ServiceCard service={service} index={i + 1} />)}
      </div>
    </div>
  </section>

  <section class="bg-surface-subtle">
    <div class="page-container py-20 lg:py-28">
      <SectionHeading class="reveal" eyebrow="Solutions" title="대표 솔루션" subtitle="자체 개발한 소프트웨어와 하드웨어로 현장의 문제를 해결합니다." />

      <div class="reveal mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-3">
        {
          SOLUTIONS.map((solution, i) => (
            <a
              href={`${ SITE.base }/services#${ solution.serviceId }`}
              class="group flex h-full items-start gap-4 rounded-2xl border border-line-secondary bg-surface-primary p-6 transition-[border-color,box-shadow] hover:border-line-info hover:shadow-sm focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-focus-ring"
            >
              <span class="text-sm font-bold text-content-brand">{String(i + 1).padStart(2, '0')}</span>
              <span class="flex-1 text-base leading-relaxed font-medium text-content-primary">{solution.name}</span>
              <span aria-hidden="true" class="text-content-brand transition-transform group-hover:translate-x-1">→</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="bg-surface-primary">
    <div class="page-container py-20 lg:py-28">
      <div class="reveal rounded-3xl bg-linear-to-br from-surface-card to-surface-subtle px-6 py-14 lg:p-16">
        <SectionHeading eyebrow="Contact Us" title="프로젝트를 상담하세요" subtitle="관측, 예측, 시각화, 시스템 통합까지 목적에 맞는 솔루션을 제안드립니다." />
        <div class="mt-9 text-center">
          <Button href={`${ SITE.base }/contact`} size="lg" shape="pill">전문가에게 문의하기</Button>
        </div>
      </div>
    </div>
  </section>
</PageLayout>
