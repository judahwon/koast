---
import SectionHeading from '@/components/common/SectionHeading.astro';
import Card from '@/components/common/Card.astro';
import { VISION, MISSION, CORE_VALUES } from '@/data/company';
---

<section class="bg-surface-primary">
  <div class="page-container py-20 lg:py-28">
    <SectionHeading class="reveal" align="left" eyebrow="Vision & Mission" title="회사 개요" subtitle={VISION.description} />

    <div class="reveal mt-14 grid gap-6 lg:mt-16 lg:grid-cols-2">
      <div class="rounded-2xl bg-surface-brand p-8 lg:p-10">
        <p class="text-sm font-bold tracking-wide text-content-on-inverse">VISION</p>
        <h3 class="mt-4 text-2xl leading-snug font-bold text-content-on-inverse lg:text-3xl">{VISION.title}</h3>
        <p class="mt-4 text-base text-content-on-inverse">{VISION.subtitle}</p>
      </div>

      <div class="rounded-2xl bg-surface-card p-8 lg:p-10">
        <p class="text-sm font-bold tracking-wide text-content-brand">MISSION</p>
        <ul class="mt-4 space-y-3">
          {
            MISSION.items.map((item) => (
              <li class="flex items-start gap-3">
                <span class="mt-2.5 size-1.5 shrink-0 rounded-full bg-surface-brand" />
                <span class="text-base text-content-secondary">{item}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<section class="bg-surface-subtle">
  <div class="page-container py-20 lg:py-28">
    <SectionHeading class="reveal" eyebrow="Core Values" title="핵심 가치" subtitle="해양·기상 도메인에 특화된 다섯 가지 기준으로 프로젝트를 수행합니다." />

    <div class="reveal mt-14 grid gap-6 sm:grid-cols-2 lg:mt-16 lg:grid-cols-5">
      {
        CORE_VALUES.map((value) => (
          <Card class="h-full text-center">
            <h3 class="text-lg font-bold text-content-primary">{value.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-content-secondary">{value.description}</p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
