---
import Card from '@/components/common/Card.astro';
import { VISION, MISSION, CORE_VALUES } from '@/data/company';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <!-- Company overview -->
  <div class="mb-16 max-w-3xl">
    <h2
      class="mb-6 text-3xl font-bold text-content-primary md:text-4xl"
    >
      회사 개요
    </h2>
    <p class="leading-relaxed text-content-tertiary">
      {VISION.description}
    </p>
    <div class="mt-6 grid grid-cols-2 gap-4 text-sm">
      <div>
        <span class="text-content-disabled">회사명</span>
        <p class="font-medium text-content-secondary">
          한국해양기상기술
        </p>
      </div>
      <div>
        <span class="text-content-disabled">분야</span>
        <p class="font-medium text-content-secondary">
          해양·기상 데이터 기반 통합 솔루션
        </p>
      </div>
      <div>
        <span class="text-content-disabled">주요 고객</span>
        <p class="font-medium text-content-secondary">
          공공기관, 연구기관, 해양·기상 관련 기업
        </p>
      </div>
      <div>
        <span class="text-content-disabled">핵심 역량</span>
        <p class="font-medium text-content-secondary">
          관측, 수집, 예측, 분석, 시각화, 시스템 구축
        </p>
      </div>
    </div>
  </div>

  <!-- Vision -->
  <div
    class="mb-16 rounded-2xl bg-surface-inverse-bolder p-8 text-content-interactive-inverse md:p-12"
  >
    <p class="mb-2 text-sm font-medium text-content-interactive-inverse/80">비전</p>
    <h3 class="text-2xl font-bold md:text-3xl">
      {VISION.title}
    </h3>
    <p class="mt-2 text-lg text-content-interactive-inverse/80">
      해양·기상 데이터를 더 정확하게 이해하고, 더 빠르게 활용할 수 있는 기술을
      만듭니다.
    </p>
  </div>

  <!-- Mission -->
  <div class="mb-16">
    <h3 class="mb-6 text-2xl font-bold text-content-primary">미션</h3>
    <div class="grid gap-4 md:grid-cols-2">
      {
        MISSION.items.map((item) => (
          <div class="flex items-start gap-3 rounded-lg bg-surface-secondary p-4">
            <div class="mt-2 size-2 shrink-0 rounded-full bg-surface-inverse-bolder" />
            <p class="text-content-secondary">{item}</p>
          </div>
        ))
      }
    </div>
  </div>

  <!-- Core Values -->
  <div>
    <h3 class="mb-6 text-2xl font-bold text-content-primary">
      핵심 가치
    </h3>
    <div class="grid gap-4 md:grid-cols-3 lg:grid-cols-5">
      {
        CORE_VALUES.map((value) => (
          <Card class="text-center">
            <h4 class="font-semibold text-content-primary">
              {value.title}
            </h4>
            <p class="mt-2 text-sm text-content-tertiary">
              {value.description}
            </p>
          </Card>
        ))
      }
    </div>
  </div>
</section>
