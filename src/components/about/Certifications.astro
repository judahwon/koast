---
import { CERTIFICATIONS, CAPABILITIES } from '@/data/company';
---

<section class="mx-auto max-w-6xl px-6 py-20">
  <div class="grid gap-12 md:grid-cols-2">
    <!-- Certifications -->
    <div>
      <h3 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">
        인증·등록
      </h3>
      <div class="flex flex-wrap gap-2">
        {
          CERTIFICATIONS.map((cert) => (
            <span class="rounded-full border border-primary-light/20 bg-primary-light/10 px-3 py-1.5 text-sm text-primary dark:text-primary-light">
              {cert}
            </span>
          ))
        }
      </div>
    </div>

    <!-- Capabilities -->
    <div>
      <h3 class="mb-6 text-2xl font-bold text-gray-900 dark:text-white">
        조직·역량
      </h3>
      <div class="space-y-3">
        {
          CAPABILITIES.map((cap) => (
            <div class="flex items-center gap-3">
              <div class="size-2 shrink-0 rounded-full bg-primary-medium dark:bg-primary-light" />
              <span class="text-gray-700 dark:text-gray-300">{cap}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
