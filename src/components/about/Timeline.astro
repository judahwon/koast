---
import SectionHeading from '@/components/common/SectionHeading.astro';
import { TIMELINE } from '@/data/company';
---

<section class="bg-surface-primary">
  <div class="page-container py-20 lg:py-28">
    <div class="grid gap-12 lg:grid-cols-[minmax(0,20rem)_minmax(0,1fr)] lg:gap-20">
      <SectionHeading class="reveal lg:sticky lg:top-28 lg:self-start" align="left" eyebrow="History" title="연혁" subtitle="2010년 설립 이후 관측·예측·시각화 전 영역으로 기술 범위를 넓혀 왔습니다." />

      <ol class="reveal">
        {
          TIMELINE.map((item) => (
            <li class="relative grid gap-2 border-l border-line-secondary pb-10 pl-8 last:pb-0 sm:grid-cols-[5rem_minmax(0,1fr)] sm:gap-6">
              <span class="absolute top-2.5 -left-1 size-2 rounded-full bg-surface-brand" />
              <p class="text-lg leading-7 font-bold text-content-interactive-primary">{item.year}</p>
              <ul class="space-y-1.5">
                {item.events.map((event) => (
                  <li class="text-base leading-7 text-content-secondary">{event}</li>
                ))}
              </ul>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>
