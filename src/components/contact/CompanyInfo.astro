---
import Card from '@/components/common/Card.astro';
import { COMPANY } from '@/utils/constants';

const fullAddress = `${ COMPANY.address } ${ COMPANY.addressDetail }`;
// 국제 표기에서는 국가번호 뒤의 0 이 빠진다.
const telHref = `tel:${ COMPANY.phone.replace(/[^\d+]/g, '').replace(/^\+820/, '+82') }`;
const mapHref = `https://map.naver.com/p/search/${ encodeURIComponent(fullAddress) }`;
---

<div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
  <Card class="h-full lg:col-span-2">
    <p class="text-xs font-bold tracking-wider text-content-brand">
      ADDRESS <span class="ml-1.5 font-medium text-content-tertiary">주소</span>
    </p>
    <address class="mt-4 text-xl leading-snug font-bold text-content-primary not-italic sm:text-2xl">
      {COMPANY.address}<br />{COMPANY.addressDetail}
    </address>
    <p class="mt-4 text-sm text-content-secondary">{COMPANY.legalName}</p>
    <a
      href={mapHref}
      target="_blank"
      rel="noopener noreferrer"
      class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-content-interactive-primary transition-colors hover:text-content-interactive-primary-hovered"
    >
      지도에서 보기
      <span aria-hidden="true">→</span>
    </a>
  </Card>

  <Card class="h-full">
    <p class="text-xs font-bold tracking-wider text-content-brand">
      TEL <span class="ml-1.5 font-medium text-content-tertiary">대표 전화</span>
    </p>
    <a
      href={telHref}
      class="mt-4 block text-xl leading-snug font-bold text-content-primary transition-colors hover:text-content-interactive-primary sm:text-2xl"
    >
      {COMPANY.phone}
    </a>
    <p class="mt-4 text-sm text-content-secondary">
      FAX. {COMPANY.fax}
    </p>
  </Card>

  <Card class="h-full">
    <p class="text-xs font-bold tracking-wider text-content-brand">
      EMAIL <span class="ml-1.5 font-medium text-content-tertiary">이메일</span>
    </p>
    <a
      href={`mailto:${ COMPANY.email }`}
      class="mt-4 block text-lg leading-snug font-bold break-all text-content-primary transition-colors hover:text-content-interactive-primary sm:text-xl"
    >
      {COMPANY.email}
    </a>
    <p class="mt-4 text-sm text-content-secondary">
      제안서·견적 요청도 이메일로 받습니다.
    </p>
  </Card>
</div>
