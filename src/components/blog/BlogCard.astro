---
import Card from '@/components/common/Card.astro';
import { formatDate } from '@/utils/formatDate';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  category: string;
  tags: string[];
  slug: string;
}

const { title, description, publishedAt, category, tags, slug } = Astro.props;
---

<a href={`${ SITE.base }/blog/${ slug }`} class="group block h-full transition-transform duration-200 hover:-translate-y-1">
  <Card variant="filled" class="flex h-full flex-col hover:shadow-lg">
    <div class="flex flex-wrap items-center gap-2">
      <span class="rounded-full bg-surface-primary px-3 py-1 text-xs font-semibold text-content-brand">{category}</span>
      <span class="text-xs text-content-tertiary">{formatDate(publishedAt)}</span>
    </div>
    <h3 class="mt-4 text-lg leading-snug font-bold text-content-primary transition-colors group-hover:text-content-interactive-primary">
      {title}
    </h3>
    <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-content-secondary">
      {description}
    </p>
    {tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((tag) => (
          <span class="rounded-md bg-surface-primary px-2 py-0.5 text-xs text-content-tertiary">#{tag}</span>
        ))}
      </div>
    )}
    <span class="mt-auto flex items-center gap-1.5 pt-6 text-sm font-semibold text-content-interactive-primary">
      자세히 보기
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </span>
  </Card>
</a>
