---
import { formatDotDate } from '@/utils/formatDate';
import { SITE } from '@/utils/constants';
import Icon from '@/components/common/Icon.astro';

interface Props {
  title: string;
  description: string;
  publishedAt: Date;
  category: string;
  tags?: string[];
  slug: string;
  thumbnail?: string;
  index?: number;
}

const { title, description, publishedAt, category, slug, thumbnail, index = 0 } = Astro.props;

// 썸네일 이미지가 없을 때 순차 적용할 브랜드 블루·시안 그라디언트 테마
const PLACEHOLDER_THEMES = [
  'from-[#0F2038] via-[#0173C2] to-[#6DC5F2]',
  'from-[#0066CC] via-[#0173C2] to-[#0F2038]',
  'from-[#0A3D62] via-[#0066CC] to-[#48CAE4]',
];
const themeGradient = PLACEHOLDER_THEMES[index % PLACEHOLDER_THEMES.length];
---

<article data-post-item data-category={category} class="group">
  <a
    href={`${ SITE.base }/blog/${ slug }`}
    class="flex flex-col-reverse gap-6 rounded-2xl transition-[color,box-shadow] duration-200 focus-visible:ring-2 focus-visible:ring-line-focus-ring focus-visible:ring-offset-8 focus-visible:outline-none md:flex-row md:items-center md:justify-between md:gap-10 lg:gap-16"
  >
    {/* 왼쪽 텍스트 영역 (데스크톱 약 65~68%) */}
    <div class="min-w-0 flex-1">
      {/* 1. 카테고리와 작성 날짜 */}
      <div class="flex items-center gap-2 text-sm sm:text-base">
        <span class="font-medium text-content-brand">{category}</span>
        <span class="text-content-tertiary" aria-hidden="true">·</span>
        <time datetime={publishedAt.toISOString()} class="text-content-tertiary">{formatDotDate(publishedAt)}</time>
      </div>

      {/* 2. 게시물 제목 */}
      <h2 class="mt-2.5 line-clamp-2 text-xl leading-snug font-bold text-content-primary transition-colors duration-200 group-hover:text-content-brand sm:mt-3 sm:text-2xl lg:text-[28px] lg:leading-snug">
        {title}
      </h2>

      {/* 3. 게시물 요약문 */}
      <p class="mt-2.5 line-clamp-2 text-base leading-relaxed text-content-secondary sm:mt-3 sm:line-clamp-3 lg:text-lg">
        {description}
      </p>
    </div>

    {/* 오른쪽 썸네일 영역 (3:2 비율, 약 300x200px) */}
    <div class="w-full shrink-0 md:w-65 lg:w-75">
      <div class="relative aspect-3/2 w-full overflow-hidden rounded-2xl bg-surface-subtle">
        {thumbnail ? (
          <img
            src={thumbnail.startsWith('http') || thumbnail.startsWith('/') ? thumbnail : `${ SITE.base }/${ thumbnail }`}
            alt=""
            class="size-full object-cover transition-transform duration-300 ease-out group-hover:scale-105"
            loading="lazy"
          />
        ) : (
          <div class={`relative flex size-full items-center justify-center bg-linear-to-br ${ themeGradient }`}>
            <div
              class="pointer-events-none absolute inset-0 opacity-15"
              style={{
                backgroundImage: 'radial-gradient(circle at 2px 2px, white 1px, transparent 0)',
                backgroundSize: '20px 20px',
              }}
            />
            <div class="relative flex size-12 items-center justify-center rounded-xl bg-white/10 text-white/80 backdrop-blur-xs transition-transform duration-300 group-hover:scale-110">
              <Icon name="Waves" class="size-6" />
            </div>
          </div>
        )}
      </div>
    </div>
  </a>
</article>

