---
interface Props {
  variant?: 'outline' | 'filled';
  padding?: 'md' | 'lg';
  class?: string;
}

const { variant = 'outline', padding = 'md', class: className = '' } = Astro.props;

const variantClass = {
  outline: 'border border-line-secondary bg-surface-primary hover:border-line-info hover:shadow-sm',
  filled: 'bg-surface-card',
}[variant];

// p-6 을 고정하면 바깥에서 p-8 을 넘길 때 tailwindcss/no-contradicting-classname 에 걸린다.
const paddingClass = padding === 'lg' ? 'p-8' : 'p-4';
---

<div class={`rounded-2xl transition-[border-color,box-shadow] ${ paddingClass } ${ variantClass } ${ className }`}>
  <slot />
</div>
