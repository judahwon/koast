---
interface Props {
  variant?: 'outline' | 'filled';
  class?: string;
}

const { variant = 'outline', class: className = '' } = Astro.props;

const variantClass = {
  outline: 'border border-line-secondary bg-surface-primary hover:border-line-info hover:shadow-sm',
  filled: 'bg-surface-card',
}[variant];
---

<div class={`rounded-2xl p-6 transition-[border-color,box-shadow] ${ variantClass } ${ className }`}>
  <slot />
</div>
