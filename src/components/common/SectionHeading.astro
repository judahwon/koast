---
interface Props {
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
}

const { title, subtitle, align = 'center' } = Astro.props;
const alignClass = align === 'center' ? 'text-center' : 'text-left';
---

<div class={`mb-12 ${ alignClass }`}>
  <h2 class="text-3xl font-bold text-content-primary">
    {title}
  </h2>
  {subtitle && (
    <p class="mx-auto mt-3 max-w-2xl text-content-tertiary">
      {subtitle}
    </p>
  )}
</div>
