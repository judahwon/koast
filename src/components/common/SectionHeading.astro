---
interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  align?: 'left' | 'center';
  class?: string;
}

const { eyebrow, title, subtitle, align = 'center', class: className = '' } = Astro.props;
const isCenter = align === 'center';
const rootClass = isCenter ? 'text-center' : 'text-left';
const subtitleClass = isCenter ? 'mx-auto max-w-3xl text-base text-content-secondary' : 'max-w-4xl text-base text-content-secondary';
---

<div class={`${ rootClass } ${ className }`}>
  {eyebrow && (
    <p class="text-sm font-bold tracking-wide text-content-brand">{eyebrow}</p>
  )}
  <h2 class="mt-3 text-2xl leading-snug font-bold tracking-tight text-content-primary sm:text-3xl lg:text-[2.5rem]">
    {title}
  </h2>
  {subtitle && (
    <p class={`mt-5 ${ subtitleClass }`}>
      {subtitle}
    </p>
  )}
</div>
