---
import { SITE, NAV_LINKS, COMPANY } from '@/utils/constants';
---

<footer class="border-t border-gray-200 bg-gray-50 dark:border-gray-700 dark:bg-gray-800">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col justify-between gap-8 md:flex-row">
      <!-- Company info -->
      <div>
        <a href={`${ SITE.base }/`} class="text-lg font-bold text-primary dark:text-primary-light">
          {SITE.name}
        </a>
        <p class="mt-2 max-w-xs text-sm text-gray-500 dark:text-gray-400">
          {SITE.description}
        </p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-wrap gap-x-8 gap-y-2">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href === '/' ? `${ SITE.base }/` : `${ SITE.base }${ link.href }`}
            class="text-sm text-gray-500 transition-colors hover:text-primary dark:text-gray-400 dark:hover:text-primary-light"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Copyright -->
    <div class="mt-8 border-t border-gray-200 pt-8 text-center dark:border-gray-700">
      <p class="text-sm text-gray-400 dark:text-gray-500">
        &copy; {new Date().getFullYear()} {COMPANY.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
