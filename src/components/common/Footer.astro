---
import { SITE, NAV_LINKS, NAV_CTA, COMPANY } from '@/utils/constants';

const links = [...NAV_LINKS, NAV_CTA];
const year = new Date().getFullYear();
---

<footer class="bg-surface-inverse-bold">
  <div class="mx-auto max-w-page px-6 py-16 lg:px-10">
    <div class="flex flex-col justify-between gap-12 lg:flex-row">
      <div>
        <div class="flex items-baseline gap-3">
          <a href={`${ SITE.base }/`} class="text-lg font-bold tracking-tight text-content-on-inverse">
            {COMPANY.wordmark}
          </a>
          <span class="text-xs text-content-on-inverse-tertiary">{COMPANY.legalName}</span>
        </div>

        <nav class="mt-6 flex flex-wrap gap-x-6 gap-y-2">
          {links.map((link) => (
            <a
              href={`${ SITE.base }${ link.href }`}
              class="text-sm text-content-on-inverse-secondary transition-colors hover:text-content-on-inverse"
            >
              {link.label}
            </a>
          ))}
        </nav>

        <p class="mt-8 text-xs text-content-on-inverse-tertiary">
          &copy; {year} {COMPANY.wordmark} ({COMPANY.name}). All rights reserved.
        </p>
      </div>

      <div class="flex gap-12 sm:gap-20">
        <div>
          <h2 class="text-xs font-bold tracking-wider text-content-on-inverse">CONTACT</h2>
          <ul class="mt-5 space-y-2.5 text-sm text-content-on-inverse-secondary">
            <li>
              <a href={`mailto:${ COMPANY.email }`} class="transition-colors hover:text-content-on-inverse">{COMPANY.email}</a>
            </li>
            <li>Tel. {COMPANY.phone}</li>
            <li>Fax. {COMPANY.fax}</li>
          </ul>
        </div>

        <div>
          <h2 class="text-xs font-bold tracking-wider text-content-on-inverse">ADDRESS</h2>
          <ul class="mt-5 space-y-2.5 text-sm text-content-on-inverse-secondary">
            <li>{COMPANY.legalName}</li>
            <li>{COMPANY.address}</li>
            <li>{COMPANY.addressDetail}</li>
          </ul>
        </div>
      </div>
    </div>
  </div>
</footer>
