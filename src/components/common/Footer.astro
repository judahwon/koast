---
import { SITE, NAV_LINKS, COMPANY } from '@/utils/constants';
---

<footer class="border-t border-line-secondary bg-surface-secondary">
  <div class="mx-auto max-w-6xl px-6 py-12">
    <div class="flex flex-col justify-between gap-8 md:flex-row">
      <!-- Company info -->
      <div>
        <a href={`${ SITE.base }/`} class="text-lg font-bold text-content-interactive-primary">
          {SITE.name}
        </a>
        <p class="mt-2 max-w-xs text-sm text-content-tertiary">
          {SITE.description}
        </p>
      </div>

      <!-- Navigation -->
      <nav class="flex flex-wrap gap-x-8 gap-y-2">
        {NAV_LINKS.map((link) => (
          <a
            href={link.href === '/' ? `${ SITE.base }/` : `${ SITE.base }${ link.href }`}
            class="text-sm text-content-tertiary transition-colors hover:text-content-interactive-primary-hovered"
          >
            {link.label}
          </a>
        ))}
      </nav>
    </div>

    <!-- Copyright -->
    <div class="mt-8 border-t border-line-secondary pt-8 text-center">
      <p class="text-sm text-content-disabled">
        &copy; {new Date().getFullYear()} {COMPANY.name}. All rights reserved.
      </p>
    </div>
  </div>
</footer>
