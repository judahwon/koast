---
import { Image } from 'astro:assets';
import Navigation from './Navigation.tsx';
import { NAV_LINKS, NAV_CTA, SITE } from '@/utils/constants';
import logo from '@/assets/images/logo.png';
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 border-b border-transparent transition-[background-color,border-color] duration-300">
  <!-- 목업 헤더는 1440 그리드가 아니라 full-bleed 다. 1920 에서 로고 x=48, CTA 우측 끝 x=1872. -->
  <div class="relative flex h-16 items-center justify-between px-6 lg:px-12">
    <a href={`${ SITE.base }/`} class="flex items-center gap-2.5">
      <Image src={logo} alt="KOAST" width={73} densities={[1, 2]} class="h-8 w-auto" />
      <span class="hidden text-base font-bold text-content-primary sm:inline">{SITE.name}</span>
    </a>
    <Navigation links={NAV_LINKS} cta={NAV_CTA} base={SITE.base} client:load />
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const base = 'fixed inset-x-0 top-0 z-50 border-b transition-[background-color,border-color] duration-300';
  const scrolled = `${ base } border-line-secondary bg-surface-primary/85 backdrop-blur-md`;
  const atTop = `${ base } border-transparent`;

  function updateHeader() {
    if (!header) return;
    header.className = window.scrollY > 8 ? scrolled : atTop;
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>
