---
import { Image } from 'astro:assets';
import Navigation from './Navigation.tsx';
import { NAV_LINKS, SITE } from '@/utils/constants';
import logo from '@/assets/images/logo.png';
---

<header class="sticky top-0 z-50 border-b border-line-secondary bg-surface-primary/80 backdrop-blur-md">
  <div class="relative mx-auto flex h-16 max-w-6xl items-center justify-between px-6">
    <a href={`${ SITE.base }/`} class="flex items-center gap-2.5">
      <!-- 로고가 진한 남색이라 다크 배경에서 대비가 부족해 밝기를 올린다. -->
      <Image
        src={logo}
        alt="KOAST"
        width={73}
        densities={[1, 2]}
        class="h-8 w-auto dark:brightness-150"
      />
      <span class="hidden text-base font-bold text-content-interactive-primary sm:inline">
        {SITE.name}
      </span>
    </a>
    <Navigation links={NAV_LINKS} base={SITE.base} client:load />
  </div>
</header>
