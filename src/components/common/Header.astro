---
import { Image } from 'astro:assets';
import Navigation from './Navigation.tsx';
import { NAV_LINKS, NAV_CTA, SITE } from '@/utils/constants';
import logoBlack from '@/assets/images/Koast_Logo_black.svg';
import logoWhite from '@/assets/images/Koast_Logo_white.svg';

interface Props {
  darkTop?: boolean;
}

const currentPath = Astro.url.pathname.replace(SITE.base, '').replace(/\/$/, '') || '/';
const isDarkHeroPage = currentPath === '/' || currentPath === '/services';
const { darkTop = isDarkHeroPage } = Astro.props;
---

<header
  id="site-header"
  data-dark-top={darkTop ? 'true' : 'false'}
  class={`group fixed inset-x-0 top-0 z-50 border-b transition-[background-color,border-color,box-shadow] duration-300 ${
    darkTop
      ? 'border-transparent bg-transparent'
      : 'is-scrolled border-line-secondary bg-surface-primary/85 shadow-xs backdrop-blur-md'
  }`}
>
  <!-- 목업 헤더는 1440 그리드가 아니라 full-bleed 다. 1920 에서 로고 x=48, CTA 우측 끝 x=1872. -->
  <div class="relative flex h-16 items-center justify-between px-6 lg:px-12">
    <a
      href={`${ SITE.base }/`}
      class="relative flex items-center rounded-md focus-visible:ring-2 focus-visible:ring-line-focus-ring focus-visible:ring-offset-4 focus-visible:outline-none"
      aria-label={SITE.name}
    >
      <div class="relative flex h-6 items-center sm:h-7">
        <!-- 흰색 로고 (투명 헤더 / 어두운 배경) -->
        <Image
          src={logoWhite}
          alt="KOAST"
          height={24}
          class={`h-5 w-auto object-contain transition-opacity duration-300 sm:h-5.5 ${
            darkTop ? 'opacity-100 group-[.is-scrolled]:opacity-0' : 'opacity-0'
          }`}
        />
        <!-- 검은색 로고 (스크롤 시 / 밝은 배경) -->
        <Image
          src={logoBlack}
          alt="KOAST"
          height={24}
          class={`absolute inset-0 my-auto h-5 w-auto object-contain transition-opacity duration-300 sm:h-5.5 ${
            darkTop ? 'opacity-0 group-[.is-scrolled]:opacity-100' : 'opacity-100'
          }`}
        />
      </div>
    </a>
    <Navigation links={NAV_LINKS} cta={NAV_CTA} base={SITE.base} darkTop={darkTop} client:load />
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const isDarkTop = header?.getAttribute('data-dark-top') === 'true';

  function updateHeader() {
    if (!header) return;
    const isScrolled = window.scrollY > 8;

    if (isDarkTop) {
      if (isScrolled) {
        header.classList.add('is-scrolled', 'border-line-secondary', 'bg-surface-primary/85', 'backdrop-blur-md', 'shadow-xs');
        header.classList.remove('border-transparent', 'bg-transparent');
      } else {
        header.classList.remove('is-scrolled', 'border-line-secondary', 'bg-surface-primary/85', 'backdrop-blur-md', 'shadow-xs');
        header.classList.add('border-transparent', 'bg-transparent');
      }
    } else {
      header.classList.add('is-scrolled', 'border-line-secondary', 'bg-surface-primary/85', 'backdrop-blur-md', 'shadow-xs');
      header.classList.remove('border-transparent', 'bg-transparent');
    }
  }

  updateHeader();
  window.addEventListener('scroll', updateHeader, { passive: true });
</script>

