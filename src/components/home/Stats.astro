---
import { Image } from 'astro:assets';
import publiccoWater from '@/assets/images/home/publicco-water.jpg';
import { QUALIFICATIONS, STATS } from '@/data/home';

function parseStatValue(val: string) {
  const match = val.match(/^([\d.,]+)(.*)$/);
  if (match) {
    return { number: match[1], unit: match[2] };
  }
  return { number: val, unit: '' };
}
---

<section id="research" class="relative flex min-h-[90vh] flex-col justify-center overflow-hidden py-40 sm:py-48 lg:py-60">
  {/* 배경 이미지 */}
  <Image
    src={publiccoWater}
    alt=""
    aria-hidden="true"
    loading="lazy"
    class="pointer-events-none absolute inset-0 z-0 size-full object-cover select-none"
  />

  {/* #000000 50% 딤 오버레이 */}
  <div class="pointer-events-none absolute inset-0 z-1 bg-black/50" aria-hidden="true" />

  <div class="page-container relative z-10 text-center">
    {/* 헤더 영역 (Impact/Eyebrow 뱃지 + 대형 타이틀 + 서브텍스트) */}
    <div class="reveal mx-auto flex max-w-3xl flex-col items-center">
      <span class="inline-flex items-center rounded-full border border-white/20 bg-black/40 px-5 py-1.5 text-xl font-semibold tracking-wide text-zinc-300 backdrop-blur-xs">
        Technology and Research
      </span>
      <h2 class="mt-5 text-3xl font-extrabold tracking-tight text-white sm:text-4xl lg:text-5xl lg:leading-tight">
        숫자로 보는 KOAST
      </h2>
      <p class="mt-4 text-sm leading-relaxed text-white/80 sm:text-base lg:text-lg">
        해양·기상 데이터 전문성과 첨단 기술력으로 안전한 미래를 만들어갑니다.
      </p>
    </div>

    {/* 스탯 영역 (4열 수평 배치 + 세로 구분선) */}
    <div class="reveal mt-20 grid grid-cols-1 gap-8 sm:grid-cols-2 sm:divide-x sm:divide-white/20 lg:mt-28 lg:grid-cols-4 lg:divide-x lg:divide-white/20">
      {STATS.map((stat) => {
        const { number, unit } = parseStatValue(stat.value);

        return (
          <div class="flex flex-col items-center justify-center px-4 py-3">
            <div class="flex items-baseline justify-center gap-1.5">
              <span class="text-4xl font-extrabold tracking-tight text-white sm:text-5xl lg:text-6xl">
                {number}
              </span>
              {unit && (
                <span class="text-lg font-bold text-white/90 sm:text-xl lg:text-2xl">
                  {unit}
                </span>
              )}
            </div>
            <p class="mt-3.5 text-xs font-medium text-white/80 sm:text-sm lg:text-base">
              {stat.label}
            </p>
          </div>
        );
      })}
    </div>

    {/* 보유 자격 뱃지 */}
    <div class="reveal mt-16 flex flex-wrap items-center justify-center gap-2 lg:mt-24">
      <span class="text-xs text-white/60">보유 자격 ·</span>
      {QUALIFICATIONS.map((qualification) => (
        <span class="rounded-full border border-white/20 bg-black/30 px-3.5 py-1.5 text-xs font-medium text-white/90 backdrop-blur-xs">
          {qualification}
        </span>
      ))}
    </div>
  </div>
</section>
