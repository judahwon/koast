---
import SectionHeading from '@/components/common/SectionHeading.astro';
import { SOLUTIONS } from '@/data/services';
---

<section class="bg-gray-50 dark:bg-gray-800/50">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <SectionHeading
      title="대표 솔루션"
      subtitle="자체 개발한 소프트웨어와 하드웨어로 현장의 문제를 해결합니다."
    />

    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {SOLUTIONS.map((solution) => (
        <div class="flex items-center gap-3 rounded-lg border border-gray-200 bg-white p-4 dark:border-gray-700 dark:bg-gray-800">
          <div class="size-2 shrink-0 rounded-full bg-primary-medium dark:bg-primary-light"></div>
          <span class="text-sm font-medium text-gray-700 dark:text-gray-300">{solution}</span>
        </div>
      ))}
    </div>
  </div>
</section>
