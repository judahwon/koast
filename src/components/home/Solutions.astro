---
import SectionHeading from '@/components/common/SectionHeading.astro';
import SolutionsAccordion from '@/components/home/SolutionsAccordion';
import { HOME_SOLUTIONS } from '@/data/home';
import { SITE } from '@/utils/constants';
---

<section id="solutions" class="bg-surface-primary py-36 lg:py-40">
  <div class="page-container reveal">
    <SectionHeading
      align="center"
      eyebrow="Solutions"
      title="공공기관의 의사결정을 지원하는 분야별 맞춤 솔루션을 제공합니다"
    />
  </div>

  <div class="mt-10 px-6 lg:mt-14">
    <SolutionsAccordion solutions={HOME_SOLUTIONS} base={SITE.base} client:load />
  </div>
</section>
