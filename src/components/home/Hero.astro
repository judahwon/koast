---
import { Image } from 'astro:assets';

import heroWave from '@/assets/images/home/hero-wave.png';
import { HERO } from '@/data/home';
---

<!-- pt 는 고정 헤더(h-16), pb 는 파도가 실제로 보이는 이미지 하단 구간(폭의 약 14%)을 비운다. -->
<section id="hero" class="relative isolate flex h-screen flex-col justify-center overflow-hidden bg-surface-primary pt-16 pb-[14vw] text-center">
  <div class="page-container reveal">
    <h1 class="text-3xl leading-snug font-bold tracking-tight text-content-primary sm:text-4xl lg:text-5xl lg:leading-15.5">
      {HERO.titleTop}<br />
      <span class="text-content-brand">{HERO.titleAccent}</span>{HERO.titleTail}
    </h1>
    <p class="mx-auto mt-7 max-w-2xl text-base leading-relaxed text-content-secondary sm:text-lg">
      {HERO.subtitle.map((line) => <span class="block">{line}</span>)}
    </p>
  </div>

  <Image
    src={heroWave}
    alt=""
    widths={[768, 1280, 1920]}
    sizes="100vw"
    loading="eager"
    aria-hidden="true"
    class="pointer-events-none absolute inset-x-0 bottom-0 -z-10 h-auto w-full select-none"
  />
</section>
