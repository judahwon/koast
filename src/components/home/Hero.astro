---
import HeroShader from './HeroShader.tsx';
---

<!-- 고정 헤더가 상단에서 투명하므로 배경 밴드를 헤더 아래까지 끌어올린다. -->
<section id="hero" class="relative isolate -mt-16 flex min-h-screen flex-col justify-center overflow-hidden pt-24 pb-32 text-center lg:pb-36">
  {/* WebGL MeshGradient 배경 셰이더 효과 */}
  <HeroShader client:only="react" />

  {/* 텍스트 가독성을 위한 은은한 다크 오버레이 */}
  <div class="pointer-events-none absolute inset-0 -z-10 bg-slate-950/25" aria-hidden="true" />

  <div class="page-container reveal relative z-10">
    <h1 class="text-3xl leading-snug font-bold tracking-tight text-white drop-shadow-lg sm:text-4xl lg:text-5xl lg:leading-15.5">
      해양과 기상 데이터로<br class="hidden sm:inline" /> 안전한 미래를 만들어갑니다.
    </h1>
  </div>
</section>
