---
import Button from '@/components/common/Button.astro';
import { SITE } from '@/utils/constants';
---

<section class="bg-surface-inverse-bolder">
  <div class="mx-auto max-w-6xl px-6 py-20">
    <div class="grid gap-12 md:grid-cols-2">
      <!-- 채용 유도 -->
      <div>
        <h3 class="text-2xl font-bold text-content-interactive-inverse">함께 만들어갈 인재를 찾습니다</h3>
        <p class="mt-3 leading-relaxed text-content-interactive-inverse/80">
          해양·기상 데이터 기술의 미래를 함께 만들 인재를 찾습니다.
        </p>
        <div class="mt-6">
          <Button href={`${ SITE.base }/careers`} variant="outline" class="border-current! text-content-interactive-inverse!">
            채용 바로가기
          </Button>
        </div>
      </div>

      <!-- 문의 유도 -->
      <div>
        <h3 class="text-2xl font-bold text-content-interactive-inverse">프로젝트를 상담하세요</h3>
        <p class="mt-3 leading-relaxed text-content-interactive-inverse/80">
          프로젝트 상담, 솔루션 도입, 기술 협력 문의를 환영합니다.
        </p>
        <div class="mt-6">
          <Button href={`${ SITE.base }/contact`} variant="outline" class="border-current! text-content-interactive-inverse!">
            문의하기
          </Button>
        </div>
      </div>
    </div>
  </div>
</section>
