---
import ScrollScaleStatement, { type FloatingCardItem } from './ScrollScaleStatement.tsx';
import illustAi from '@/assets/images/home/illust-ai.png';
import illustBigData from '@/assets/images/home/illust-bigdata.png';
import illustGis from '@/assets/images/home/illust-gis.png';
import solutionBuoy from '@/assets/images/home/solution-buoy.jpg';
import solutionControl from '@/assets/images/home/solution-control.jpg';
import solutionTidal from '@/assets/images/home/solution-tidal.jpg';
import solutionVessel from '@/assets/images/home/solution-vessel.jpg';
import waveSkyImage from '@/assets/images/home/wave_sky_image.webp';

// 좌측 컬럼 카드 5개 (1번 카드부터 아래에서 순차적으로 상승, 1·3·5 수직 평행, 2·4 수직 평행)
const leftCards: FloatingCardItem[] = [
  {
    id: 'left-1',
    image: solutionBuoy.src,
    alt: '해양 관측 부이 데이터 수집',
    side: 'left',
    xPercent: -28,
    baseYPercent: -30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-2',
    image: solutionTidal.src,
    alt: '디지털트윈 조석 및 조류 가시화',
    side: 'left',
    xPercent: -35,
    baseYPercent: 0,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-3',
    image: illustAi.src,
    alt: 'AI 기반 해양 예측 모델',
    side: 'left',
    xPercent: -28,
    baseYPercent: 30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-4',
    image: solutionControl.src,
    alt: '실시간 해양 종합 관제',
    side: 'left',
    xPercent: -35,
    baseYPercent: 60,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-5',
    image: illustBigData.src,
    alt: '빅데이터 기반 해양 분석 플랫폼',
    side: 'left',
    xPercent: -28,
    baseYPercent: 90,
    scrollSpeedMultiplier: 1.0,
  },
];

// 우측 컬럼 카드 5개 (1번 카드부터 아래에서 순차적으로 상승, 1·3·5 수직 평행, 2·4 수직 평행)
const rightCards: FloatingCardItem[] = [
  {
    id: 'right-1',
    image: solutionControl.src,
    alt: '실시간 해양 모니터링 시스템',
    side: 'right',
    xPercent: 28,
    baseYPercent: -30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-2',
    image: solutionVessel.src,
    alt: '스마트 항만 및 선박 관제',
    side: 'right',
    xPercent: 35,
    baseYPercent: 0,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-3',
    image: illustGis.src,
    alt: 'GIS 기반 해양 공간 정보 가시화',
    side: 'right',
    xPercent: 28,
    baseYPercent: 30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-4',
    image: solutionBuoy.src,
    alt: '스마트 관측망 네트워크',
    side: 'right',
    xPercent: 35,
    baseYPercent: 60,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-5',
    image: illustAi.src,
    alt: '머신러닝 해양 재난 조기 경보',
    side: 'right',
    xPercent: 28,
    baseYPercent: 90,
    scrollSpeedMultiplier: 1.0,
  },
];
---

<section id="statement" class="bg-surface-primary">
  <ScrollScaleStatement
    client:load
    mainImageSrc={waveSkyImage.src}
    mainImageWidth={waveSkyImage.width}
    mainImageHeight={waveSkyImage.height}
    leftCards={leftCards}
    rightCards={rightCards}
  />
</section>

