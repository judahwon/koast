---
import ScrollScaleStatement, { type FloatingCardItem } from './ScrollScaleStatement.tsx';
import imageCloud from '@/assets/images/home/image_cloud.webp';
import imageDeepOcean from '@/assets/images/home/image_deep-ocean.webp';
import imageFish from '@/assets/images/home/image_fish.webp';
import imageMountain from '@/assets/images/home/image_mountain.webp';
import imageOcean from '@/assets/images/home/image_ocean.webp';
import imageRadar from '@/assets/images/home/image_radar.webp';
import imageRain from '@/assets/images/home/image_rain.webp';
import imageSnow from '@/assets/images/home/image_snow.webp';
import imageStorm from '@/assets/images/home/image_storm.webp';
import imageWideViewOcean from '@/assets/images/home/image_wide-view-ocean.webp';
import waveSkyImage from '@/assets/images/home/wave_sky_image.webp';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

// 카드가 220px 정사각 object-cover 라 짧은 변이 2배(440px) 이상이어야 레티나에서 흐려지지 않는다.
const CARD_SIDE_2X = 440;
const cardSrc = async (img: ImageMetadata, scale = 1) => {
  const width = Math.ceil(CARD_SIDE_2X * scale * Math.max(1, img.width / img.height));
  return (await getImage({ src: img, width })).src;
};

const mainImage = await getImage({ src: waveSkyImage, width: 1600, widths: [960, 1600, 2400] });

// 좌측 컬럼 카드 5개 (1번 카드부터 아래에서 순차적으로 상승, 1·3·5 수직 평행, 2·4 수직 평행)
const leftCards: FloatingCardItem[] = [
  {
    id: 'left-1',
    image: await cardSrc(imageCloud),
    alt: '기상 구름 관측 데이터',
    side: 'left',
    xPercent: -28,
    baseYPercent: -30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-2',
    image: await cardSrc(imageDeepOcean),
    alt: '심해 해양 관측',
    side: 'left',
    xPercent: -35,
    baseYPercent: 0,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-3',
    image: await cardSrc(imageFish),
    alt: '해양 생태 및 수산 자원 모니터링',
    side: 'left',
    xPercent: -28,
    baseYPercent: 30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-4',
    image: await cardSrc(imageMountain),
    alt: '산악 기상 및 지형 관측',
    side: 'left',
    xPercent: -35,
    baseYPercent: 60,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'left-5',
    image: await cardSrc(imageOcean),
    alt: '연안 해양 환경 분석',
    side: 'left',
    xPercent: -28,
    baseYPercent: 90,
    scrollSpeedMultiplier: 1.0,
  },
];

// 우측 컬럼 카드 5개 (1번 카드부터 아래에서 순차적으로 상승, 1·3·5 수직 평행, 2·4 수직 평행)
const rightCards: FloatingCardItem[] = [
  {
    id: 'right-1',
    image: await cardSrc(imageRadar),
    alt: '기상 레이더 및 원격 탐사',
    side: 'right',
    xPercent: 28,
    baseYPercent: -30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-2',
    image: await cardSrc(imageRain),
    alt: '강수량 및 기상 예측',
    side: 'right',
    xPercent: 35,
    baseYPercent: 0,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-3',
    image: await cardSrc(imageSnow),
    alt: '적설 및 동절기 기상 모니터링',
    side: 'right',
    xPercent: 28,
    baseYPercent: 30,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-4',
    image: await cardSrc(imageStorm),
    alt: '태풍 및 해양 재난 조기 경보',
    side: 'right',
    xPercent: 35,
    baseYPercent: 60,
    scrollSpeedMultiplier: 1.0,
  },
  {
    id: 'right-5',
    image: await cardSrc(imageWideViewOcean, 1.15),
    alt: '광역 해양 공간 정보 가시화',
    side: 'right',
    xPercent: 28,
    baseYPercent: 90,
    scrollSpeedMultiplier: 1.0,
    imageScale: 1.15,
  },
];
---

<section id="statement" class="scroll-mt-16 bg-surface-primary">
  <ScrollScaleStatement
    client:load
    mainImageSrc={mainImage.src}
    mainImageSrcSet={mainImage.srcSet.attribute}
    mainImageWidth={waveSkyImage.width}
    mainImageHeight={waveSkyImage.height}
    leftCards={leftCards}
    rightCards={rightCards}
  />
</section>

