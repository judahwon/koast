---
import { Image } from 'astro:assets';

import SectionHeading from '@/components/common/SectionHeading.astro';
import { BUSINESS_AREAS } from '@/data/home';
---

<section id="business" class="bg-surface-primary pt-20 pb-16 lg:pt-30 lg:pb-20">
  <div class="page-container">
    <SectionHeading
      align="left"
      eyebrow="Business Area"
      title="클라우드와 AI 기반 기술 전문성을 바탕으로 다양한 솔루션을 제공합니다"
      subtitle="(주)한국해양기상기술은 AI, 빅데이터, GIS 기술을 기반으로 국가 연구개발사업을 수행하며 공공 안전과 산업 혁신에 기여하고 있습니다."
      class="reveal"
    />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {BUSINESS_AREAS.map((area) => (
        <article class="reveal relative h-[357px] overflow-hidden rounded-2xl bg-surface-card px-8 pt-9 lg:px-10 lg:pt-10">
          <p class="text-sm text-content-secondary">{area.label}</p>
          <p class="mt-3 text-3xl font-bold text-content-primary">{area.title}</p>
          <Image
            src={area.illustration}
            alt=""
            aria-hidden="true"
            class="pointer-events-none absolute right-0 bottom-0 h-auto w-[59%] select-none"
          />
        </article>
      ))}
    </div>
  </div>
</section>
