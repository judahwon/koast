---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/common/SectionHeading.astro';
import { BUSINESS_AREAS } from '@/data/home';
import { SITE } from '@/utils/constants';
---

<section id="business" class="scroll-mt-16 bg-slate-50 pt-44 pb-40 lg:pt-56 lg:pb-48">
  <div class="page-container">
    <SectionHeading
      align="left"
      eyebrow="Business Area"
      title="클라우드와 AI GIS 기반 기술 전문성을 보유하고 있습니다"
      class="reveal"
    />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {BUSINESS_AREAS.map((area, index) => (
        <a
          href={`${ SITE.base }${ area.href }`}
          aria-label={`${ area.title } 자세히 보기`}
          class="reveal group/flipping-card block h-[357px] w-full rounded-2xl perspective-[1000px] focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-line-focus-ring"
        >
          <div class="relative size-full rounded-2xl border border-slate-200 bg-white transition-transform duration-700 transform-3d group-focus-within/flipping-card:transform-[rotateY(180deg)] group-hover/flipping-card:transform-[rotateY(180deg)]">
            {/* Front Face */}
            <div class="absolute inset-0 flex size-full transform-[rotateY(0deg)] flex-col justify-between overflow-hidden rounded-2xl bg-white px-8 pt-9 backface-hidden lg:px-10 lg:pt-10">
              <div class="relative z-10">
                <p class="text-xl font-semibold text-content-secondary">{area.label}</p>
                <p class="mt-2 text-3xl font-bold text-content-primary lg:text-4xl">{area.title}</p>
              </div>

              <div class={`floating-wrapper pointer-events-none absolute right-0 bottom-0 w-[59%] select-none floating-card-${ index + 1 }`}>
                <Image
                  src={area.illustration}
                  alt=""
                  aria-hidden="true"
                  class="h-auto w-full object-contain transition-transform duration-500 ease-out group-hover/flipping-card:scale-105"
                />
              </div>
            </div>

            {/* Back Face */}
            <div class="absolute inset-0 flex size-full transform-[rotateY(180deg)] flex-col justify-between rounded-2xl border border-surface-inverse-bold bg-surface-inverse-bold p-8 backface-hidden lg:p-10">
              <div>
                <p class="text-lg font-bold tracking-wide text-brand-primary-light">
                  {area.title}
                </p>
                <h3 class="mt-2 text-2xl leading-snug font-bold tracking-tight text-content-on-inverse">
                  {area.backTitle}
                </h3>
                <p class="mt-3 text-lg leading-8 text-content-on-inverse-secondary">
                  {area.description}
                </p>
              </div>

              <div class="flex justify-end pt-4">
                <span class="inline-flex items-center gap-2 text-base font-medium text-content-on-inverse">
                  자세히 보기
                  <span aria-hidden="true" class="transition-transform duration-200 group-hover/flipping-card:translate-x-1">→</span>
                </span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes floatMotion1 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1.5deg);
    }
  }

  @keyframes floatMotion2 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(-1.5deg);
    }
  }

  @keyframes floatMotion3 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1.2deg);
    }
  }

  .floating-wrapper {
    transition: transform 0.5s ease-out;
    will-change: transform;
  }

  .group\/flipping-card:hover .floating-card-1 {
    animation: floatMotion1 3s ease-in-out infinite;
  }

  .group\/flipping-card:hover .floating-card-2 {
    animation: floatMotion2 3.2s ease-in-out infinite;
  }

  .group\/flipping-card:hover .floating-card-3 {
    animation: floatMotion3 3.1s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .group\/flipping-card .relative {
      transition: none !important;
      transform: none !important;
    }
    .group\/flipping-card:hover .floating-card-1,
    .group\/flipping-card:hover .floating-card-2,
    .group\/flipping-card:hover .floating-card-3 {
      animation: none !important;
    }
  }
</style>
