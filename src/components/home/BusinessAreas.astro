---
import { Image } from 'astro:assets';
import SectionHeading from '@/components/common/SectionHeading.astro';
import { BUSINESS_AREAS } from '@/data/home';
import { SITE } from '@/utils/constants';
---

<section id="business" class="bg-surface-primary pt-36 pb-32 lg:pt-44 lg:pb-36">
  <div class="page-container">
    <SectionHeading
      align="left"
      eyebrow="Business Area"
      title="클라우드와 AI 기반 기술 전문성을 바탕으로 다양한 솔루션을 제공합니다"
      subtitle="(주)한국해양기상기술은 AI, 빅데이터, GIS 기술을 기반으로 국가 연구개발사업을 수행하며 공공 안전과 산업 혁신에 기여하고 있습니다."
      class="reveal"
    />

    <div class="mt-12 grid grid-cols-1 gap-6 sm:grid-cols-2 lg:mt-20 lg:grid-cols-3">
      {BUSINESS_AREAS.map((area, index) => (
        <a
          href={`${ SITE.base }${ area.href }`}
          class="reveal group relative block h-[357px] overflow-hidden rounded-2xl border border-line-secondary bg-white px-8 pt-9 shadow-xs transition-all duration-300 hover:-translate-y-1 hover:border-line-info hover:shadow-xl focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-line-focus-ring lg:px-10 lg:pt-10"
        >
          <p class="text-sm text-content-secondary">{area.label}</p>
          <p class="mt-3 text-3xl font-bold text-content-primary">{area.title}</p>
          <span class="mt-4 inline-flex items-center gap-1.5 text-sm font-semibold text-content-brand">
            자세히 보기
            <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
          </span>
          <div class={`floating-wrapper pointer-events-none absolute right-0 bottom-0 w-[59%] select-none floating-card-${ index + 1 }`}>
            <Image
              src={area.illustration}
              alt=""
              aria-hidden="true"
              class="h-auto w-full object-contain transition-transform duration-500 ease-out group-hover:scale-105"
            />
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  @keyframes floatMotion1 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1.5deg);
    }
  }

  @keyframes floatMotion2 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-10px) rotate(-1.5deg);
    }
  }

  @keyframes floatMotion3 {
    0%, 100% {
      transform: translateY(0px) rotate(0deg);
    }
    50% {
      transform: translateY(-12px) rotate(1.2deg);
    }
  }

  .floating-wrapper {
    transition: transform 0.5s ease-out;
    will-change: transform;
  }

  .group:hover .floating-card-1,
  .group:focus-visible .floating-card-1 {
    animation: floatMotion1 3s ease-in-out infinite;
  }

  .group:hover .floating-card-2,
  .group:focus-visible .floating-card-2 {
    animation: floatMotion2 3.2s ease-in-out infinite;
  }

  .group:hover .floating-card-3,
  .group:focus-visible .floating-card-3 {
    animation: floatMotion3 3.1s ease-in-out infinite;
  }

  @media (prefers-reduced-motion: reduce) {
    .group:hover .floating-card-1,
    .group:hover .floating-card-2,
    .group:hover .floating-card-3,
    .group:focus-visible .floating-card-1,
    .group:focus-visible .floating-card-2,
    .group:focus-visible .floating-card-3 {
      animation: none !important;
    }
  }
</style>
