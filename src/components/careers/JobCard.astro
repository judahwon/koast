---
import Card from '@/components/common/Card.astro';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  department: string;
  location: string;
  type: string;
  experience: string;
  slug: string;
}

const { title, department, location, type, experience, slug } = Astro.props;
const meta = [location, type, experience];
---

<a href={`${ SITE.base }/careers/${ slug }`} class="group block transition-transform duration-200 hover:-translate-y-0.5">
  <Card class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between">
    <div>
      <h3 class="text-xl leading-snug font-bold text-content-primary transition-colors group-hover:text-content-interactive-primary">
        {title}
      </h3>
      <div class="mt-3 flex flex-wrap items-center gap-2">
        <span class="rounded-full bg-surface-card px-3 py-1 text-xs font-semibold text-content-brand">{department}</span>
        {meta.map((item) => (
          <span class="rounded-full border border-line-secondary px-3 py-1 text-xs text-content-secondary">{item}</span>
        ))}
      </div>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-full border border-line-info px-5 py-2.5 text-sm font-semibold text-content-brand transition-colors group-hover:bg-interactive-selected md:self-auto">
      자세히 보기
      <span aria-hidden="true" class="transition-transform group-hover:translate-x-1">→</span>
    </span>
  </Card>
</a>
