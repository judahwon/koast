---
import Card from '@/components/common/Card.astro';
import Icon from '@/components/common/Icon.astro';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  department: string;
  location: string;
  type: string;
  experience: string;
  slug: string;
}

const { title, department, location, type, experience, slug } = Astro.props;
const meta = [
  { icon: 'MapPin', label: location },
  { icon: 'Briefcase', label: type },
  { icon: 'Clock', label: experience },
];
---

<a href={`${ SITE.base }/careers/${ slug }`} class="group block transition-transform duration-200 hover:-translate-y-0.5">
  <Card class="flex flex-col gap-5 md:flex-row md:items-center md:justify-between md:gap-8">
    <div class="flex items-start gap-4">
      <span class="grid size-12 shrink-0 place-items-center rounded-xl bg-surface-card text-content-brand transition-colors group-hover:bg-interactive-selected">
        <Icon name="Briefcase" class="size-6" />
      </span>
      <div>
        <h3 class="text-xl leading-snug font-bold text-content-primary transition-colors group-hover:text-content-interactive-primary">
          {title}
        </h3>
        <div class="mt-3 flex flex-wrap items-center gap-2">
          <span class="inline-flex items-center gap-1.5 rounded-full bg-surface-card px-3 py-1 text-xs font-semibold text-content-brand">
            <Icon name="Users" class="size-3.5" />
            {department}
          </span>
          {meta.map((item) => (
            <span class="inline-flex items-center gap-1.5 rounded-full border border-line-secondary px-3 py-1 text-xs text-content-secondary">
              <Icon name={item.icon} class="size-3.5" />
              {item.label}
            </span>
          ))}
        </div>
      </div>
    </div>
    <span class="inline-flex shrink-0 items-center gap-1.5 self-start rounded-full border border-line-info px-5 py-2.5 text-sm font-semibold text-content-brand transition-colors group-hover:bg-interactive-selected md:self-auto">
      자세히 보기
      <Icon name="ChevronRight" class="size-4 transition-transform group-hover:translate-x-1" />
    </span>
  </Card>
</a>
