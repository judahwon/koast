---
import Card from '@/components/common/Card.astro';
import { SITE } from '@/utils/constants';

interface Props {
  title: string;
  department: string;
  location: string;
  type: string;
  experience: string;
  slug: string;
}

const { title, department, location, type, experience, slug } = Astro.props;
---

<a href={`${ SITE.base }/careers/${ slug }`} class="group block">
  <Card class="transition-colors hover:border-line-info">
    <div class="flex flex-col gap-3 md:flex-row md:items-center md:justify-between">
      <div>
        <h3 class="text-lg font-semibold text-content-primary transition-colors group-hover:text-content-interactive-primary-hovered">
          {title}
        </h3>
        <div class="mt-2 flex flex-wrap gap-2">
          <span class="rounded-full bg-surface-info-subtle px-2 py-0.5 text-xs text-content-interactive-primary">
            {department}
          </span>
          <span class="rounded-full bg-surface-tertiary px-2 py-0.5 text-xs text-content-tertiary">
            {location}
          </span>
          <span class="rounded-full bg-surface-tertiary px-2 py-0.5 text-xs text-content-tertiary">
            {type}
          </span>
          <span class="rounded-full bg-surface-tertiary px-2 py-0.5 text-xs text-content-tertiary">
            {experience}
          </span>
        </div>
      </div>
      <span class="shrink-0 text-sm font-medium text-content-interactive-primary">
        자세히 보기 →
      </span>
    </div>
  </Card>
</a>
